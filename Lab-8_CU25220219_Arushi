#include <iostream>
using namespace std;
int main()
{
    int N, M, K;
    cin >> N >> M >> K;
    int u[10000], v[10000], w[10000];
    for (int i = 0; i < M; i++)
    {
        cin >> u[i] >> v[i] >> w[i];
    }
    const int INF = 1000000000;
    int dp[1001];
    int newdp[1001];
    for (int i = 1; i <= N; i++)
        dp[i] = INF;
    dp[1] = 0;
    for (int edges = 1; edges <= K; edges++)
    {
        for (int i = 1; i <= N; i++)
            newdp[i] = dp[i];
        for (int i = 0; i < M; i++)
        {
            if (dp[u[i]] != INF)
            {
                int value = dp[u[i]] + w[i];
                if (value < newdp[v[i]])
                    newdp[v[i]] = value;
            }
            if (dp[v[i]] != INF)
            {
                int value = dp[v[i]] + w[i];
                if (value < newdp[u[i]])
                    newdp[u[i]] = value;
            }
        }
        for (int i = 1; i <= N; i++)
            dp[i] = newdp[i];
    }
    if (dp[N] == INF)
        cout << -1;
    else
        cout << dp[N];
    return 0;
}
