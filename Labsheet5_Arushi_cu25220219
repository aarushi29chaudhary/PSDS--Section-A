bool runQuery(const string &sql, const string &db = "") {
    string dbFlag = db.empty() ? "" : "-D " + db + " ";
    string command = MYSQL_PATH + " -u" + USER + " -p" + PASSWORD + " " +
                      dbFlag + "-e \"" + sql + "\"";
    string wrappedCommand = "\"" + command + "\"";
    int result = system(wrappedCommand.c_str());
    if (result != 0) {
        cerr << "Query failed: " << sql << endl;
        return false;
    }
    return true;
}

