#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int key;
int hamming(int a) {
    int x = a ^ key;
    int count = 0;
    while (x > 0) {
        count += x & 1;
        x = x >> 1;
    }
    return count;
}
bool compare(int a, int b) { 
    int A = hamming(a);
    int B = hamming(b);
    if (A != B)
        return A < B;
    return a < b;   
}
int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n >> key;
        vector<int> arr(n);
        for (int i = 0; i < n; i++)
            cin >> arr[i];
        sort(arr.begin(), arr.end(), compare);
        for (int i = 0; i < n; i++)
            cout << arr[i] << " ";
        cout << "\n";
    }
    return 0;
}
