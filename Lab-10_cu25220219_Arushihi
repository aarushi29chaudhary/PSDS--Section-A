#include <iostream>
using namespace std;
int digitSum(int n)
{
    int sum = 0;
    while (n > 0)
    {
        sum = sum + n % 10;
        n = n / 10;
    }
    return sum;
}
int main()
{
    int N;
    cin >> N;
    int nums[100];
    for (int i = 0; i < N; i++)
    {
        cin >> nums[i];
    }
    int count = 0;
    for (int i = 0; i < N; i++)
    {
        for (int j = i + 1; j < N; j++)
        {
            if (digitSum(nums[i]) == digitSum(nums[j]))
            {
                count++;
            }
        }
    }
    cout << count;
    return 0;
} 
